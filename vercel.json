{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "icn1"
  ],
  "buildCommand": "prisma generate && next build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.susanfather.com"
        }
      ],
      "destination": "https://susanfather.com/:path*",
      "permanent": true
    }
  ]
}
